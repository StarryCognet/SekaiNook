# 版本日志是 scripts/changelog-sync.mjs 生成的（写 LF）。
# 本机 core.autocrlf=true 且没有这条规则时，git 检出会把它转成 CRLF，
# 于是 changelog:fallback --check 会误报「与 Web 仓库的版本日志不一致」
# （内容其实逐字节相同，只差每行一个 CR）。
app/lib/config/changelog.dart text eol=lf

# 部署/运维脚本在 Linux 上执行：CRLF 会让 shebang 变成 "/bin/sh^M"，
# 报 bad interpreter，或者让 nginx / compose 的配置解析出错。
# 本机 core.autocrlf=true，不加这几条 checkout 出来就是 CRLF。
*.sh          text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf


# 依赖
node_modules/

# 构建产物
dist/
dist-ssr/

# 环境变量（含密钥，禁止提交）
.env
.env.local
.env.*.local

# Cloudflare 本地密钥 / wrangler 状态
.dev.vars
.wrangler/

# wrangler types 生成的类型文件
worker-configuration.d.ts

# 日志
logs/
*.log
npm-debug.log*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 测试 / 覆盖率
coverage/

# 版本日志同步时生成的 SQL（内容来自 src/config/changelog.ts，别提交）
migrations/.changelog-sync.sql

# 图标工作目录（本地生成脚本与候选图，不入库）
.icon-work/

# 本地临时目录（截图 / flclash 工作区 / 校验产物，动辄几个 G，不入库）
.tmp-*/

# 国内测试站部署的临时产物（D1 快照 data.sql、nginx 配置草稿、Flutter Web 打包 tar）
.snapshot/

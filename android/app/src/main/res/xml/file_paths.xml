<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 只放出应用内更新要用的那个下载目录（见 AppUpdateApi.downloadApk：
     写进 getTemporaryDirectory()/updates/）。范围给窄一点，别把整个私有目录暴露出去。 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="update_apk" path="updates/" />
    <files-path name="update_apk_files" path="updates/" />
</paths>

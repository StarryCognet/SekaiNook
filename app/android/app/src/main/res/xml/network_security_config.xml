<?xml version="1.0" encoding="utf-8"?>
<!-- 线上后端是 https，只有连本地 wrangler（http://127.0.0.1:8788）调试时才需要明文。
     Android 9 起默认禁止明文 HTTP，这里只给本机 / 模拟器宿主地址开口子，其余仍强制加密。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 真机用 adb reverse 时走 127.0.0.1；模拟器访问宿主机走 10.0.2.2 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 正式环境：自建服务器暂时只有 IP、没有域名和证书，App 走明文 HTTP。
             将来上了域名 + HTTPS 后，这一条可以删掉。 -->
        <domain includeSubdomains="false">140.143.240.238</domain>
    </domain-config>
</network-security-config>

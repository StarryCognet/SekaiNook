{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sekainook-reminder",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  // 和 Pages 项目同一个 D1（database_id 一致），所以提醒读的是同一份流水
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sekainook",
      "database_id": "bef627b5-9c70-42ae-b8ec-7f51d6edb7b8"
    }
  ],
  // 21:30 北京时间 = 13:30 UTC（Cloudflare 的 cron 一律按 UTC 解释）
  "triggers": {
    "crons": ["30 13 * * *"]
  },
  "vars": {
    "NTFY_SERVER": "https://ntfy.sh",
    "APP_URL": "https://sn.starrymiku.com/home",
    // 默认走 Web Push（孩子安卓 Chrome 开网站、妈妈 iPhone 把网站加到主屏幕，都不用装 App）。
    // 想临时换通道：手动触发时带 ?channel=ntfy / ?channel=bark / ?channel=webhook
    "PUSH_CHANNEL": "webpush",
    // Web Push 的公钥（公开信息，可以写在配置里）；私钥是 secret：
    //   npx wrangler secret put VAPID_PRIVATE_KEY
    // 这份公钥必须与 Pages 项目 wrangler.jsonc 里那份完全一致（浏览器订阅时用它）
    "VAPID_PUBLIC_KEY": "BD4ePdfDf4U2Q5pFQuJ85o6bFNuUhKaiwvF-VAUyKRS-S8epOpLggQirGEV1RzMnmLM6ZrtBHH0_yLebZ-6hGsQ",
    "VAPID_SUBJECT": "https://sn.starrymiku.com"
  }
  // NTFY_TOPIC / REMIND_TOKEN / NTFY_TOKEN / VAPID_PRIVATE_KEY 是 secret，不进这个文件：
  //   npx wrangler secret put NTFY_TOPIC
  //   npx wrangler secret put REMIND_TOKEN
  //   npx wrangler secret put VAPID_PRIVATE_KEY
  // 本地联调写在同目录的 .dev.vars（已 gitignore）
}

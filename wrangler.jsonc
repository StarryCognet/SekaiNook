{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sekainook",
  // 前端静态产物目录（Vite 构建输出），Cloudflare Pages 从这里发布
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-09-01",
  // D1 数据库绑定：函数内通过 env.DB 访问
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sekainook",
      "database_id": "bef627b5-9c70-42ae-b8ec-7f51d6edb7b8"
    }
  ],
  // R2 对象存储绑定：图片上传/读取使用
  "r2_buckets": [
    {
      "binding": "STARRYMIKU_BUCKET",
      "bucket_name": "starrymiku"
    }
  ],
  // Web Push（手机提醒）的 VAPID 公钥：`GET /api/push/key` 要把它发给浏览器，
  // 浏览器订阅时用它当 applicationServerKey。公钥是公开信息，写在这里没问题；
  // 私钥只在 workers/reminder 那个 Worker 里（secret），不在这份配置里。
  // ⚠️ 这两处必须是同一对密钥，改了要一起改。
  "vars": {
    "VAPID_PUBLIC_KEY": "BD4ePdfDf4U2Q5pFQuJ85o6bFNuUhKaiwvF-VAUyKRS-S8epOpLggQirGEV1RzMnmLM6ZrtBHH0_yLebZ-6hGsQ",
    "VAPID_SUBJECT": "https://sn.starrymiku.com",
    // 提醒 Worker 的地址：设置页的「自检控制台」要打它（/health、/trigger）。
    // 调用令牌走 secret：npx wrangler pages secret put REMIND_TOKEN
    // （令牌只留在服务端 —— 自检是服务端代打 Worker，浏览器拿不到它）
    "REMINDER_URL": "https://sekainook-reminder.3398377037.workers.dev"
  }
}
